{
  "name": "o-mais-otario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "nodemon --legacy-watch --polling-interval 500 --watch app --watch components --watch lib --watch scripts --ext ts,tsx,css,js,mjs,json --ignore .next --ignore node_modules --delay 0.4 --signal SIGTERM --exec \"next dev --hostname 0.0.0.0 --port 3000 --turbopack\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
